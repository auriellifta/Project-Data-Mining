# ==============================================================================
# NALARA CAREER PREDICTION PYTHON API - ENVIRONMENT TEMPLATE
# Salin ke .env.api (JANGAN pernah men-commit file berisi kunci asli ke Git!)
# ==============================================================================

# Port HTTP container (platform PaaS seperti Railway/Render/Cloud Run otomatis mengisi PORT)
PORT=5000

# WAJIB: Kunci rahasia autentikasi internal antara Supabase Edge Function (predict-career)
# dan layanan Python API ini. Harus sama persis dengan secret NALARA_PYTHON_API_KEY di Supabase.
# Gunakan string acak kuat minimal 32 karakter (contoh: openssl rand -hex 32).
NALARA_API_KEY=

# Konfigurasi Gunicorn WSGI (opsional; default ringan untuk container 512 MB - 1 GB RAM)
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
